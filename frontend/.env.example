# Defaults to /api, which works with the dev proxy in vite.config.ts (same
# origin as the Vite dev server). In production, when the frontend (Vercel)
# and backend (Render) are on different domains, this must be the full
# deployed API URL, and CORS_ORIGIN on the backend must include this exact
# frontend origin.
# VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=/api
