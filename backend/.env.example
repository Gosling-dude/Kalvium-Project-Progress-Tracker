# Database (SQLite for local dev; see DEPLOYMENT.md for Postgres/Neon in production)
DATABASE_URL="file:./dev.db"
# Only used by prisma/postgres/schema.prisma (production). Neon gives you two
# connection strings: a pooled one (use for DATABASE_URL) and an unpooled
# "direct" one (use for DIRECT_DATABASE_URL — migrations run against this).
# DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/db?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Auth
# Must be a long random value in production — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="12h"
COOKIE_NAME="kalvium_session"

# Server
PORT=4000
NODE_ENV=development
# The deployed frontend's exact origin(s), comma-separated if more than one
# (e.g. a production domain plus a Vercel preview URL). No wildcard support.
# CORS_ORIGIN="https://your-app.vercel.app,https://your-custom-domain.com"
CORS_ORIGIN="http://localhost:5173"

# Email
# EMAIL_MODE controls how the EmailService behaves:
#   mock -> never contacts a real provider, just logs to EmailEvent/EmailDeliveryAttempt (default, safe for dev/tests)
#   smtp -> sends via SMTP using the settings below
EMAIL_MODE="mock"
EMAIL_FROM="Kalvium Project Defence <no-reply@kalvium.example>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Seed / bootstrap admin
SEED_ADMIN_EMAIL="admin@kalvium.example"
SEED_ADMIN_PASSWORD="ChangeMe123!"
